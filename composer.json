{
    "name": "nswdpc/silverstripe-elemental-iframe",
    "description": "Elemental iframe module, supports lazy loading of iframes",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "nsw",
        "iframe",
        "elemental"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Mark Taylor",
            "role": "Developer"
        },
        {
            "name": "James Ellis",
            "role": "Developer"
        }
    ],
    "require": {
        "dnadesign/silverstripe-elemental": "^6",
        "codem/silverstripe-html5-inputs": "dev-ss6",
        "gorriecoe/silverstripe-link": "6.x-dev"
    },
    "repositories": [
        {
          "type": "git",
          "url": "git@github.com:catalyst/silverstripe-link.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "NSWDPC\\Elemental\\Models\\Iframe\\": [
                "src/Models/Elements/"
            ],
            "NSWDPC\\Elemental\\Tests\\Iframe\\": [
                "tests/"
            ]
        }
    },
    "extra": {
        "expose": [
            "client/static"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
